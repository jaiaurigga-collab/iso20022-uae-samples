      <MsgId>CAMT053-UAE-20261117-01</MsgId>
      <CreDtTm>2026-11-17T18:00:00+04:00</CreDtTm>
    </GrpHdr>
    <Stmt>
      <Id>STMT-2026-11-17-001</Id>
      <CreDtTm>2026-11-17T18:00:00+04:00</CreDtTm>
      <Acct>
        <Id>
          <IBAN>AE070331234567890123456</IBAN>
        </Id>
        <Ccy>AED</Ccy>
        <Svcr>
          <FinInstnId>
            <BICFI>BOMLAEADXXX</BICFI>
          </FinInstnId>
        </Svcr>
      </Acct>
      <Bal>
        <Tp>
          <CdOrPrtry>
            <Cd>OPBD</Cd>
          </CdOrPrtry>
        </Tp>
        <Amt Ccy="AED">250000.00</Amt>
        <CdtDbtInd>CRDT</CdtDbtInd>
        <Dt>
          <Dt>2026-11-17</Dt>
        </Dt>
      </Bal>
      <Bal>
        <Tp>
          <CdOrPrtry>
            <Cd>CLBD</Cd>
          </CdOrPrtry>
        </Tp>
        <Amt Ccy="AED">295000.00</Amt>
        <CdtDbtInd>CRDT</CdtDbtInd>
        <Dt>
          <Dt>2026-11-17</Dt>
        </Dt>
      </Bal>
      <Ntry>
        <Amt Ccy="AED">45000.00</Amt>
        <CdtDbtInd>CRDT</CdtDbtInd>
        <Sts>
          <Cd>BOOK</Cd>
